# === Web Apps (.env.local) ===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# === Site password gate (each web app, set per Vercel project) ===
# Set: the whole site (pages, API, files) asks for this password first.
# Unset: gate off. Never commit a real value — this repo is public.
SITE_PASSWORD=

# === Pipeline (.env) ===
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# === RAG Agent ===
VOYAGE_API_KEY=

# === GitHub Actions Secrets ===
# ANTHROPIC_API_KEY
# GEMINI_API_KEY
# SUPABASE_URL
# SUPABASE_SERVICE_KEY
# R2_ACCESS_KEY_ID
# R2_SECRET_ACCESS_KEY
# R2_ENDPOINT
# R2_PUBLIC_URL
# VERCEL_DEPLOY_HOOK
